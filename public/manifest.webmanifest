{
  "name": "Tilde — all the sites you read, in one place",
  "short_name": "Tilde",
  "description": "A free RSS reader with no account. Tilde collects new posts from the sites you pick and keeps everything on your own device.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f2f2",
  "theme_color": "#f3f2f2",
  "orientation": "any",
  "categories": ["news", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Unread", "url": "/app", "description": "Everything you have not read yet" },
    { "name": "Saved", "url": "/app", "description": "Articles you kept for later" }
  ]
}
